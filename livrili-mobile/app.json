{
  "expo": {
    "name": "Livrili",
    "slug": "livrili-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "com.bouhezila.livrili",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1976d2"
    },
    "android": {
      "package": "com.bouhezila.livrili",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#1976d2"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#006233"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e4788ddc-be9f-4a4a-8a99-7ca909eb8ea4"
      }
    }
  }
}
